<?xml version="1.0" encoding="UTF-8"?>
<!--
  autonomous-car.fz  —  Fritzing sketch (BEST-EFFORT, gerado sem o app Fritzing)

  AVISO IMPORTANTE
  ================
  Este arquivo foi escrito MANUALMENTE, fora do aplicativo Fritzing e sem a
  biblioteca oficial de peças (fzp/svg). Consequências esperadas ao abrir:
    - As peças podem aparecer como "não encontradas" (moduleIdRef não resolvido),
      pois os IDs nativos do core do Fritzing não são reproduzíveis à mão.
    - Os fios (wires) NÃO estão incluídos, porque dependem dos connectorId exatos
      de cada peça, que só existem na definição oficial.
  Ou seja: serve como PONTO DE PARTIDA / esqueleto. A montagem fiel deve ser
  feita seguindo docs/assembly/fritzing-guide.md (netlist completa abaixo, em
  comentário) e conferida contra docs/assembly/README.md e include/config.h.

  NETLIST (referência — ver fritzing-guide.md):
    Bateria.+  -> Chave -> L298N.VS ; Bateria.- -> GND comum ; L298N.GND -> Mega.GND
    Mega.5V -> 5V rail (todos VCC) ; Mega.GND -> GND rail (todos GND)
    Mega.5->ENA  22->IN1 23->IN2 24->IN3 25->IN4  6->ENB
    L298N.OUT1/2 -> Motor Esq ; OUT3/4 -> Motor Dir
    Mega.30->HC-SR04.TRIG  31->ECHO
    Mega.A0->IR_Linha_E.OUT  A1->IR_Linha_C.OUT  A2->IR_Linha_D.OUT
    Mega.32->IR_Obstaculo.OUT
    Mega.20(SDA)->HuskyLens.R   21(SCL)->HuskyLens.T
-->
<module fritzingVersion="0.9.6" moduleId="autonomous-car-sketch">
  <title>autonomous-car</title>
  <instances>
    <instance moduleIdRef="ArduinoMEGA2560" modelIndex="1">
